{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "edit": "allow",
    "bash": {
      "rm -rf *": "deny",
      "rm -r *": "deny",
      "rm --recursive *": "deny",
      "rm -f *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "chmod 777 *": "deny",
      "chmod -R 777 *": "deny",
      "chmod a+rwx *": "deny",
      "chmod -R a+rwx *": "deny",
      "chown -R *": "deny",
      "mkfs *": "deny",
      "mkfs.* *": "deny",
      "fdisk *": "deny",
      "gdisk *": "deny",
      "parted *": "deny",
      "diskutil eraseDisk *": "deny",
      "diskutil partitionDisk *": "deny",
      "dd if=*": "deny",
      "shutdown *": "deny",
      "reboot *": "deny",
      "poweroff *": "deny",
      "halt *": "deny",
      "kill -9 *": "deny",
      "pkill *": "deny",
      "git reset --hard *": "deny",
      "git clean -fd*": "deny",
      "git clean -fx*": "deny",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git branch -D *": "deny",
      "docker rm -f *": "deny",
      "docker rmi *": "deny",
      "docker system prune*": "deny",
      "docker volume rm *": "deny",
      "docker volume prune*": "deny",
      "kubectl delete *": "deny",
      "kubectl apply *": "deny",
      "kubectl replace *": "deny",
      "kubectl patch *": "deny",
      "kubectl scale *": "deny",
      "kubectl rollout undo *": "deny",
      "terraform destroy *": "deny",
      "terraform apply *": "deny",
      "terraform state rm *": "deny",
      "terraform state mv *": "deny",
      "ssh *": "deny",
      "scp *": "deny",
      "sftp *": "deny",
      "rsync *": "deny",
      "nc *": "deny",
      "ncat *": "deny",
      "netcat *": "deny",
      "telnet *": "deny",
      "ftp *": "deny",
      "curl * | sh": "deny",
      "curl * | bash": "deny",
      "wget * | sh": "deny",
      "wget * | bash": "deny",
      "npm install -g *": "deny",
      "npm uninstall *": "deny",
      "pip install *": "deny",
      "pip uninstall *": "deny",
      "pip3 install *": "deny",
      "pip3 uninstall *": "deny",
      "pipx install *": "deny",
      "brew install *": "deny",
      "brew uninstall *": "deny",
      "apt install *": "deny",
      "apt remove *": "deny",
      "apt purge *": "deny",
      "dotnet tool install *": "deny",
      "dotnet tool uninstall *": "deny",
      "cat ~/.ssh/*": "deny",
      "cat ~/.aws/*": "deny",
      "cat ~/.azure/*": "deny",
      "cat ~/.npmrc": "deny",
      "cat ~/.docker/config.json": "deny",
      "printenv": "deny",
      "env": "deny",
      "ssh-add -L": "deny",
      "git credential *": "deny",
      "gh auth token": "deny",
      "az account get-access-token *": "deny",
      "aws sts get-caller-identity": "deny",
      "git filter-branch *": "deny",
      "git filter-repo *": "deny",
      "git reflog delete *": "deny"
    }
  },
  "lsp": false,
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}