{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "ls *": "allow",
      "ls": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "printf *": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "cut *": "allow",
      "tr *": "allow",
      "find *": "allow",
      "which *": "allow",
      "whoami": "allow",
      "date *": "allow",
      "date": "allow",
      "sleep *": "allow",
      "podman exec sql2025 *": "allow",
      "podman logs *": "allow",
      "podman ps *": "allow",
      "podman images *": "allow",
      "docker exec sql2025 *": "allow",
      "docker logs *": "allow",
      "docker ps *": "allow",
      "docker images *": "allow",
      "python3 query-testing/*": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "chmod 777 *": "deny"
    }
  },
  "lsp": false,
  "mcp": {
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    }
  }
}
